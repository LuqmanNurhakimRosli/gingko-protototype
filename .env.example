# Copy to .env.local (never commit real keys).
# Everything below except VITE_* stays on the server and never reaches the browser.

# ── AI copilot: choose one provider ──────────────────────────────────────
# OpenRouter (one key, many models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any model slug from https://openrouter.ai/models that supports tool calling.
# Default: anthropic/claude-opus-5.5 — check the exact slug on openrouter.ai/models and set it here.
OPENROUTER_MODEL=
# Optional: your public site URL, shown to OpenRouter as the calling app
COPILOT_SITE_URL=

# …or the Claude API directly: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5, claude-haiku-5-5
COPILOT_MODEL=

# Optional: openrouter | anthropic. Unset: OpenRouter if its key is set, else the Claude API.
AI_PROVIDER=
# Optional: low | medium (default) | high | xhigh | max (OpenRouter: xhigh/max act as high)
COPILOT_EFFORT=
# Optional, production: comma-separated allowed Origin values
COPILOT_ALLOWED_ORIGINS=

# ── Optional Google basemap (Map Tiles API). Browser key: restrict it by HTTP referrer. ──
VITE_GOOGLE_MAPS_API_KEY=
